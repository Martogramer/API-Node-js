PORT=3000
FRONTEND_URL=http://localhost:5173  
SEMRUSH_API_KEY=tu_api_key_aqui

# Google Service Account JSON path (usar JSON de cuenta de servicio)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# Google Search Console: site URL (ej. https://midominio.com)
GSC_SITE_URL=https://midominio.com

# GA4: propiedad id (ej. '123456789')
GA4_PROPERTY_ID=YOUR_GA4_PROPERTY_ID

# Email (nodemailer) - para enviar reportes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=supersecret

# Optional: SerpApi key (si quieres usar free tier)
SERPAPI_KEY=
